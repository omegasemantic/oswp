# ============================================================
# EVENT QUERY COOKBOOK — fetch once, query many
# ============================================================

# --- setup: pull snapshots once, reuse for everything below ---
events=$(curl -s http://localhost:8080/wp-json/wp/v2/event)
staff=$(curl -s http://localhost:8080/wp-json/wp/v2/staff)
venues=$(curl -s http://localhost:8080/wp-json/wp/v2/venue)
categories=$(curl -s http://localhost:8080/wp-json/wp/v2/event_category)

# reusable name-lookup defs — paste before any query that needs them
LOOKUPS='
  def staffname($id): ($staff[] | select(.id == $id) | .name) // "unassigned";
  def venuename($id): ($venues[] | select(.id == $id) | .name) // "unknown";
  def catname($id): ($categories[] | select(.id == $id) | .name) // "unknown";
'


# ============================================================
# COORDINATOR / STAFF QUERIES
# ============================================================

# -- who's coordinating what (raw ID) --
echo "$events" | jq '
  [.[] | select(.acf.coordinator != null)]
  | .[] | {title: .title.rendered, coordinator_id: .acf.coordinator}
'

# -- who's coordinating what (resolved name) --
echo "$events" | jq --argjson staff "$staff" "
  $LOOKUPS
  [.[] | select(.acf.coordinator != null)]
  | .[] | {title: .title.rendered, coordinator: staffname(.acf.coordinator)}
"

# -- everything ONE coordinator is running (swap the ID) --
echo "$events" | jq '[.[] | select(.acf.coordinator == 25)] | .[] | .title.rendered'

# -- events with NO coordinator yet (a to-do list) --
echo "$events" | jq '[.[] | select(.acf.coordinator == null)] | .[] | .title.rendered'


# ============================================================
# GENERIC NAME/TEXT SEARCH — "search 'rodger'" style
# ============================================================

# -- search event titles for a substring, case-insensitive --
search_term="market"
echo "$events" | jq --arg q "$search_term" '
  [.[] | select(.title.rendered | ascii_downcase | contains($q | ascii_downcase))]
  | .[] | .title.rendered
'

# -- search by coordinator NAME instead of ID (e.g. "search 'rodger' events") --
search_name="Rodger"
echo "$events" | jq --argjson staff "$staff" --arg name "$search_name" "
  $LOOKUPS
  [.[] | select(.acf.coordinator != null and (staffname(.acf.coordinator) | ascii_downcase | contains(\$name | ascii_downcase)))]
  | .[] | {title: .title.rendered, coordinator: staffname(.acf.coordinator)}
"

# -- search venue by name --
search_venue="gallery"
echo "$events" | jq --argjson venues "$venues" --arg v "$search_venue" "
  $LOOKUPS
  [.[] | select((.venue // []) | map(venuename(.)) | join(\",\") | ascii_downcase | contains(\$v | ascii_downcase))]
  | .[] | .title.rendered
"


# ============================================================
# DATE / DATE-RANGE QUERIES
# ============================================================

# -- single date, on/after --
echo "$events" | jq --arg from "2026-08-01" '
  [.[] | select(.acf.event_date >= $from)] | .[] | {title: .title.rendered, date: .acf.event_date}
'

# -- date RANGE (between two dates) --
echo "$events" | jq --arg from "2026-08-01" --arg to "2026-08-31" '
  [.[] | select(.acf.event_date >= $from and .acf.event_date <= $to)]
  | .[] | {title: .title.rendered, date: .acf.event_date}
'

# -- whole month shorthand (matches "2026-08" prefix) --
echo "$events" | jq --arg month "2026-08" '
  [.[] | select(.acf.event_date | startswith($month))]
  | .[] | {title: .title.rendered, date: .acf.event_date}
'


# ============================================================
# COMBINING CONDITIONS
# ============================================================

# -- date range AND has a coordinator assigned --
echo "$events" | jq --arg from "2026-08-01" --arg to "2026-08-31" '
  [.[] | select(.acf.event_date >= $from and .acf.event_date <= $to and .acf.coordinator != null)]
  | .[] | {title: .title.rendered, date: .acf.event_date, coordinator_id: .acf.coordinator}
'

# -- name search AND date range together --
search_term="market"
echo "$events" | jq --arg q "$search_term" --arg from "2026-08-01" --arg to "2026-08-31" '
  [.[] | select(
      (.title.rendered | ascii_downcase | contains($q | ascii_downcase))
      and .acf.event_date >= $from
      and .acf.event_date <= $to
    )]
  | .[] | {title: .title.rendered, date: .acf.event_date}
'
