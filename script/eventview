#!/usr/bin/env bash
# eventview — plain-text field:value dump of Raglan Arts Centre events
#
# Usage:
#   ./eventview                    all events
#   ./eventview august             event_date starts 2026-08
#   ./eventview 2026-08            same, explicit month
#   ./eventview coord:rodger       coordinator name contains "rodger" (case-insensitive)
#   ./eventview venue:gallery      venue name contains "gallery"
#   ./eventview search:market      title contains "market"
#   ./eventview nocoord            events with no coordinator assigned
set -euo pipefail

BASE="http://localhost:8080/wp-json/wp/v2"
FILTER="${1:-}"

# --- fetch once, snapshot everything this run needs ---
events=$(curl -s "$BASE/event?per_page=100")
categories=$(curl -s "$BASE/event_category?per_page=100")
venues=$(curl -s "$BASE/venue?per_page=100")
staff=$(curl -s "$BASE/staff?per_page=100")

# --- parse the one argument into a jq select() condition ---
# default: no filter, show everything
select_expr='true'

case "$FILTER" in
  "")
    select_expr='true'
    ;;
  august)
    select_expr='((.acf.event_date // "") | startswith("2026-08"))'
    ;;
  july)
    select_expr='((.acf.event_date // "") | startswith("2026-07"))'
    ;;
  september)
    select_expr='((.acf.event_date // "") | startswith("2026-09"))'
    ;;
  coord:*)
    term="${FILTER#coord:}"
    select_expr=".acf.coordinator != null and (staffname(.acf.coordinator) | ascii_downcase | contains(\"${term,,}\"))"
    ;;
  venue:*)
    term="${FILTER#venue:}"
    select_expr="((.venue // []) | map(venuename(.)) | join(\",\") | ascii_downcase | contains(\"${term,,}\"))"
    ;;
  search:*)
    term="${FILTER#search:}"
    select_expr="(.title.rendered | ascii_downcase | contains(\"${term,,}\"))"
    ;;
  nocoord)
    select_expr='(.acf.coordinator == null)'
    ;;
  [0-9][0-9][0-9][0-9]-[0-9][0-9])
    # explicit YYYY-MM
    select_expr="((.acf.event_date // \"\") | startswith(\"$FILTER\"))"
    ;;
  *)
    echo "Unrecognised filter: $FILTER" >&2
    echo "See --help / top-of-file comments for supported forms." >&2
    exit 1
    ;;
esac

jq -n \
  --argjson events "$events" \
  --argjson cats "$categories" \
  --argjson venues "$venues" \
  --argjson staff "$staff" \
  -r \
  "
  def catname(\$id): (\$cats[] | select(.id == \$id) | .name) // \"—\";
  def venuename(\$id): (\$venues[] | select(.id == \$id) | .name) // \"—\";
  def staffname(\$id): (\$staff[] | select(.id == \$id) | .name) // \"—\";

  \$events
  | map(select($select_expr))
  | .[]
  | \"Event: \\(.title.rendered)\\n\" +
    \"  -- WordPress --\\n\" +
    \"  ID: \\(.id)\\n\" +
    \"  Slug: \\(.slug)\\n\" +
    \"  Status: \\(.status)\\n\" +
    \"  WP Date (created): \\(.date)\\n\" +
    \"  Modified: \\(.modified)\\n\" +
    \"  Link: \\(.link)\\n\" +
    \"  -- Taxonomy --\\n\" +
    \"  Category: \\((.event_category // []) | map(catname(.)) | join(\", \") | if . == \"\" then \"—\" else . end)\\n\" +
    \"  Venue: \\((.venue // []) | map(venuename(.)) | join(\", \") | if . == \"\" then \"—\" else . end)\\n\" +
    \"  Coordinator: \\(if .acf.coordinator then staffname(.acf.coordinator) else \"—\" end)\\n\" +
    \"  -- ACF --\\n\" +
    \"  event_date: \\(.acf.event_date // \"—\")\\n\" +
    \"  event_end: \\(.acf.event_end // \"—\")\\n\" +
    \"  is_recurring: \\(.acf.is_recurring // \"—\")\\n\" +
    \"  recurrence_day: \\(.acf.recurrence_day // \"—\")\\n\" +
    \"  recurrence_frequency: \\(.acf.recurrence_frequency // \"—\")\\n\" +
    \"  is_featured: \\(.acf.is_featured // \"—\")\\n\" +
    \"  attendance_type: \\(.acf.attendance_type // \"—\")\\n\" +
    \"  attendance_note: \\(.acf.attendance_note // \"—\")\\n\" +
    \"  attendance_link: \\(.acf.attendance_link // \"—\")\\n\" +
    \"  booking_required: \\(.acf.booking_required // \"—\")\\n\" +
    \"\\n----------------------------------------\\n\"
  "
