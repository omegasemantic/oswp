#!/usr/bin/env bash
# schemaview — plain-text printout of the 'event' CPT's ACF schema
# Run this ON the box with docker/WP-CLI access (not from eventview's box).
set -euo pipefail

WP="docker exec -it oswp-wordpress-1 wp --allow-root"

echo "===================================="
echo " EVENT SCHEMA"
echo "===================================="
echo

# --- Custom Post Type itself ---
echo "-- Post Type --"
$WP post-type get event --fields=name,label,public,hierarchical 2>/dev/null || echo "  (post type 'event' not found via wp-cli)"
echo

# --- Taxonomies registered on this CPT ---
echo "-- Taxonomies --"
for tax in event_category venue; do
  echo "  $tax:"
  $WP taxonomy get "$tax" --fields=label,public 2>/dev/null | sed 's/^/    /'
  echo "    terms:"
  $WP term list "$tax" --fields=id,name --format=csv 2>/dev/null | tail -n +2 | sed 's/^/      /'
  echo
done

# --- ACF Field Groups + Fields ---
echo "-- ACF Field Groups --"
group_ids=$($WP post list --post_type=acf-field-group --field=ID 2>/dev/null)

for gid in $group_ids; do
  gname=$($WP post get "$gid" --field=post_title 2>/dev/null)
  echo "Field Group: $gname (post ID $gid)"

  field_ids=$($WP post list --post_type=acf-field --post_parent="$gid" --field=ID 2>/dev/null)

  for fid in $field_ids; do
    fname=$($WP post get "$fid" --field=post_title 2>/dev/null)
    fkey=$($WP post get "$fid" --field=post_name 2>/dev/null)
    # field config is stored as serialized/JSON post_content depending on ACF version
    ftype=$($WP post meta get "$fid" type 2>/dev/null || echo "—")
    allow_bindings=$($WP post meta get "$fid" allow_in_bindings 2>/dev/null || echo "—")

    echo "  Field: $fname"
    echo "    key: $fkey"
    echo "    type: $ftype"
    echo "    allow_in_bindings: $allow_bindings"
  done
  echo
done
