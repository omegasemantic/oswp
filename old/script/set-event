#!/usr/bin/env bash
# event-set — write a DATA value onto an existing event.
# This is DATA, not STRUCTURE. It requires the field to already exist
# (added via schema-edit first). It never changes what fields are available.
#
# Usage:
#   ./event-set <event_id> <acf_field_name> <value>      -- plain ACF field
#   ./event-set <event_id> coordinator <staff_term_name>  -- taxonomy field
#
# Examples:
#   ./event-set 6 event_date "2026-08-14 19:30:00"
#   ./event-set 6 coordinator "Mary"
set -euo pipefail

WP="docker exec -it oswp-wordpress-1 wp --allow-root"

EVENT_ID="${1:?event ID required}"
FIELD="${2:?field name required}"
VALUE="${3:?value required}"

if [ "$FIELD" = "coordinator" ]; then
  # taxonomy field — set by term name, not raw meta
  $WP post term set "$EVENT_ID" staff "$VALUE"
else
  $WP post meta update "$EVENT_ID" "$FIELD" "$VALUE"
fi

echo "--- confirming ---"
if [ "$FIELD" = "coordinator" ]; then
  $WP post term list "$EVENT_ID" staff
else
  $WP post meta get "$EVENT_ID" "$FIELD"
fi
