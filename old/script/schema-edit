#!/usr/bin/env bash
# schema-edit — open ACF field-group JSON directly in vim.
# This is STRUCTURE, not DATA. Editing here changes what fields exist;
# it never touches existing event values.
#
# Usage:
#   ./schema-edit            edit the Event Details group (default)
#   ./schema-edit list       list all field-group JSON files available
#   ./schema-edit <file>     edit a specific group by filename
set -euo pipefail

JSON_DIR="$HOME/oswp/wp-content/themes/twentytwentyfive/acf-json"
DEFAULT_GROUP="group_6a606d82f3bb0.json"   # Event Details

case "${1:-}" in
  list)
    ls -1 "$JSON_DIR"
    ;;
  "")
    vim "$JSON_DIR/$DEFAULT_GROUP"
    ;;
  *)
    vim "$JSON_DIR/$1"
    ;;
esac
