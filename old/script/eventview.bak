#!/usr/bin/env bash
# eventview — plain-text field:value dump of Raglan Arts Centre events
# Usage:
#   ./eventview                 all events
#   ./eventview august          events where event_date starts 2026-08
#   ./eventview 2026-08         same, explicit
set -euo pipefail

BASE="http://localhost:8080/wp-json/wp/v2"
FILTER="${1:-}"

# --- fetch once, snapshot everything this run needs ---
events=$(curl -s "$BASE/event?per_page=100")
categories=$(curl -s "$BASE/event_category?per_page=100")
venues=$(curl -s "$BASE/venue?per_page=100")

# month-name shorthand -> YYYY-MM prefix (extend as needed)
case "$FILTER" in
  august)   prefix="2026-08" ;;
  july)     prefix="2026-07" ;;
  september) prefix="2026-09" ;;
  "") prefix="" ;;
  *) prefix="$FILTER" ;;  # assume already YYYY-MM or blank
esac

jq -n \
  --argjson events "$events" \
  --argjson cats "$categories" \
  --argjson venues "$venues" \
  --arg prefix "$prefix" \
  -r '
  def catname($id): ($cats[] | select(.id == $id) | .name) // "—";
  def venuename($id): ($venues[] | select(.id == $id) | .name) // "—";

  $events
  | map(select($prefix == "" or ((.acf.event_date // "") | startswith($prefix))))
  | .[]
  | "Event: \(.title.rendered)\n" +
    "  -- WordPress --\n" +
    "  ID: \(.id)\n" +
    "  Slug: \(.slug)\n" +
    "  Status: \(.status)\n" +
    "  WP Date (created): \(.date)\n" +
    "  Modified: \(.modified)\n" +
    "  Link: \(.link)\n" +
    "  -- Taxonomy --\n" +
    "  Category: \((.event_category // []) | map(catname(.)) | join(", ") | if . == "" then "—" else . end)\n" +
    "  Venue: \((.venue // []) | map(venuename(.)) | join(", ") | if . == "" then "—" else . end)\n" +
    "  -- ACF --\n" +
    "  event_date: \(.acf.event_date // "—")\n" +
    "  event_end: \(.acf.event_end // "—")\n" +
    "  is_recurring: \(.acf.is_recurring // "—")\n" +
    "  recurrence_day: \(.acf.recurrence_day // "—")\n" +
    "  recurrence_frequency: \(.acf.recurrence_frequency // "—")\n" +
    "  is_featured: \(.acf.is_featured // "—")\n" +
    "  attendance_type: \(.acf.attendance_type // "—")\n" +
    "  attendance_note: \(.acf.attendance_note // "—")\n" +
    "  attendance_link: \(.acf.attendance_link // "—")\n" +
    "  booking_required: \(.acf.booking_required // "—")\n" +
    "\n----------------------------------------\n"
  '
